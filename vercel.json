{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "app/api/cron/reminders/route.ts": {
      "maxDuration": 300
    },
    "app/api/upload/[token]/route.ts": {
      "maxDuration": 60
    }
  }
}
