# ============================================================================
# KLIGER - Environment Variables (.env.local for local dev)
# ============================================================================
# העתק לקובץ .env.local ומלא. הקובץ הזה לא נכלל ב-Git.

# ---------- Database (חובה) ----------
# מ-Neon (https://console.neon.tech) → העתק את "Connection string"
# בפורמט: postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# אם ב-Windows יש DATABASE_URL מערכתי (SQL Server) שדורס את .env.local —
# הגדר גם את השורה הבאה (עדיפות גבוהה יותר בקוד):
POSTGRES_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ---------- כתובת האתר הציבורית (חובה) ----------
# בפיתוח: http://localhost:3000
# בהפקה:  הכתובת של Vercel (למשל https://kliger.vercel.app)
APP_URL=http://localhost:3000

# ---------- Admin ראשוני (חובה בהפעלה הראשונה) ----------
# בפעם הראשונה שמישהו ינסה להיכנס — אם אין כלום ב-DB, ייווצר admin עם הערכים
# האלה. אחרי הכניסה הראשונה מומלץ למחוק את ADMIN_INITIAL_PASSWORD מכאן.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=מנהל המערכת
ADMIN_INITIAL_PASSWORD=change-me-please

# ---------- Google OAuth (חובה לשליחת מיילים) ----------
# ראה DEPLOY_HEBREW.md לפרטים
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# חשוב: הסוד ב-Vercel חייב להיות אותו סוד שעובד עם ה-refresh token.
# אם יש כמה Client Secrets ב-Google Cloud — השתמש בזה שתואם לחיבור הנוכחי.
# ברירת מחדל אם ריק: {APP_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------- Vercel Blob (אופציונלי בפיתוח, חובה בהפקה) ----------
# בפיתוח מקומי: אם ריק, קבצים ייכתבו ל-./uploads/ בתיקייה המקומית.
# בפרודקשיין (Vercel): Vercel Blob מוסיף אוטומטית את המשתנה BLOB_READ_WRITE_TOKEN
# אחרי שמחברים Blob Store, אין צורך להעתיק אותו לכאן.
BLOB_READ_WRITE_TOKEN=

# ---------- Cron Secret (אופציונלי) ----------
# מגן על /api/cron/reminders מקריאות חיצוניות. Vercel Cron ישלח אוטומטית
# Authorization: Bearer $CRON_SECRET. השאר ריק בפיתוח.
CRON_SECRET=

# ---------- SMTP Fallback (אופציונלי) ----------
# משמש רק אם אין למשתמש חיבור Google. שימושי לפיתוח או לשליחת מיילי מערכת
# מהאדמין הראשי לפני שחיבר את חשבון הגוגל שלו.
# עבור Gmail: השתמש ב-App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=KLIGER
SMTP_FROM_EMAIL=

# ---------- Local scheduler (אופציונלי, dev בלבד) ----------
# בפרודקשיין ה-cron רץ דרך Vercel Cron ולא צריך את זה.
# ל-dev: ENABLE_LOCAL_CRON=1 יפעיל node-cron יומי.
ENABLE_LOCAL_CRON=
REMINDERS_HOUR=9
